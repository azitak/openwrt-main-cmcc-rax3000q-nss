#
# CMCC RAX3000Q (IPQ5018 + QCA8337 + QCN6102), 256 MB RAM, 128 MB SPI-NAND
#
# Baseline: OpenWrt main of 2026-10-09 plus the NSS-on-mainline series
# (kuncy7/openwrt-nss-edma, branch c3po-tag-8021q), kernel 6.18.60.
# Memory group "256m": ath11k 256M profile + NSS LOW, which is what makes
# two radios plus the NSS core fit in 256 MB.
#
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_cmcc_rax3000q=y

# --- board -------------------------------------------------------------
# upstream ships this device without DEVICE_PACKAGES; our image profile adds
# both, and the BDF package is the board's own calibration data
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-cmcc_rax3000q=y

# --- 256 MB memory profile ---------------------------------------------
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_NSS_MEM_PROFILE_LOW=y

# --- NSS wired plane (kmod-qca-dwmac-nss + drv + ecm + qca-dsa-nss) -----
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

# --- Wi-Fi on the NSS path (ath11k wifili) ------------------------------
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y

# --- SQM in the NSS firmware (shipped switched off) --------------------
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_tc-full=y

# --- what bug reports ask for ------------------------------------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_dumpimage=y

# --- LuCI (the NSS tree's own images leave it out) ---------------------
# NOT the "luci" meta package: it drags luci-app-nss into the graph, which
# selects nss-tools, which CONFLICTS with nss-tools-dwmac - kconfig then
# silently drops one of the two and the NSS plane disappears from the image.
# The components are listed instead; luci-app-nss can be installed later.
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y

# --- build metadata ----------------------------------------------------
CONFIG_KERNEL_BUILD_DOMAIN="openwrt-main-cmcc-rax3000q-nss"
CONFIG_KERNEL_BUILD_USER="azitak"
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y

# --- apk repositories --------------------------------------------------
# The nss feed is local to this project (kuncy7/nss-packages), not published
# at downloads.openwrt.org.  PER_FEED_REPO would otherwise write a
# .../packages/aarch64_cortex-a53/nss/packages.adb line into the image and
# `apk update` would fail on it forever.  Tristate M keeps the feed's packages
# buildable but emits that one repository line commented out.
CONFIG_PER_FEED_REPO=y
CONFIG_FEED_nss=m
