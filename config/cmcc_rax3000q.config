#
# CMCC RAX3000Q (IPQ5018 + QCA8337 + QCN6102), 256 MB RAM, 128 MB SPI-NAND
#
# Baseline: OpenWrt main of 2026-10-09 plus the NSS-on-mainline series
# (kuncy7/openwrt-nss-edma, branch c3po-tag-8021q), kernel 6.18.60.
# Memory group "256m": ath11k 256M profile + NSS LOW, which is what makes
# two radios plus the NSS core fit in 256 MB.
#
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_cmcc_rax3000q=y

# --- board -------------------------------------------------------------
# upstream ships this device without DEVICE_PACKAGES; our image profile adds
# both, and the BDF package is the board's own calibration data
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-cmcc_rax3000q=y

# --- 256 MB memory profile ---------------------------------------------
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_NSS_MEM_PROFILE_LOW=y

# --- NSS wired plane (kmod-qca-dwmac-nss + drv + ecm + qca-dsa-nss) -----
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

# --- Wi-Fi on the NSS path (ath11k wifili) ------------------------------
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y

# --- SQM in the NSS firmware (shipped switched off) --------------------
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_tc-full=y

# --- what bug reports ask for ------------------------------------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_dumpimage=y

# --- zram swap ---------------------------------------------------------
# Compressed swap for the 256 MB RAM; size defaults to RAM/2, tunable via
# system.@system[0].zram_size_mb.
CONFIG_PACKAGE_zram-swap=y

# --- LuCI ---------------------------------------------------------------
# The "luci" meta package only pulls luci-light + luci-app-package-manager.
# The earlier concern that it would select luci-app-nss / nss-tools was wrong:
# nss-tools is @BROKEN on ipq50xx and this feed ships no luci-app-nss at all.
# setup.sh verifies nss-tools-dwmac survives defconfig.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
# Argon is a third-party theme, staged by setup.sh as a local src-link feed
# (its Makefile must sit in a subdirectory for OpenWrt's feed scanner).
# Bootstrap stays the default theme, so a broken theme cannot take down LuCI.
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
# Simplified Chinese
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# --- Wi-Fi: full wpad for 802.11k/v/r ----------------------------------
# Verified on the device with `hostapd -t`: wpad-basic-mbedtls accepts the
# RRM (11k) and FT (11r) keys but rejects bss_transition / wnm_sleep_mode
# (11v) as "unknown configuration item".  The full variant enables WNM.
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# --- build metadata ----------------------------------------------------
CONFIG_KERNEL_BUILD_DOMAIN="openwrt-main-cmcc-rax3000q-nss"
CONFIG_KERNEL_BUILD_USER="azitak"
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y

# --- apk repositories --------------------------------------------------
# This is a SNAPSHOT image, so it needs a mirror that actually carries
# snapshots/.  TUNA explicitly does not mirror snapshots (only releases),
# hence USTC: an OpenWrt tier-1 mirror in China whose snapshots indexes were
# checked (base/luci/packages + qualcommax/ipq50xx all 200).
# VERSION_REPO (what %U expands to in include/feeds.mk) lives under
# menuconfig VERSIONOPT, which itself is hidden
# unless IMAGEOPT is on and defaults to n - without these two, defconfig
# silently drops CONFIG_VERSION_REPO and the image reverts to the official
# URL.  files/etc/apk/repositories.d/distfeeds.list is a second, independent
# guard so the shipped source is correct even if this ever changes.
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_REPO="https://mirrors.ustc.edu.cn/openwrt/snapshots"
CONFIG_PER_FEED_REPO=y
# nss (kuncy7/nss-packages) and argon (jerrykuku/luci-theme-argon) are local
# feeds, not published on any OpenWrt mirror.  Tristate M comments their
# repository lines out while leaving the packages themselves buildable.
CONFIG_FEED_nss=m
CONFIG_FEED_argon=m
