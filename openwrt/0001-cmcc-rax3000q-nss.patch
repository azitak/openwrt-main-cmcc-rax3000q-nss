diff --git a/target/linux/qualcommax/dts/ipq5018-rax3000q.dts b/target/linux/qualcommax/dts/ipq5018-rax3000q.dts
index 0d88be7..c284b79 100644
--- a/target/linux/qualcommax/dts/ipq5018-rax3000q.dts
+++ b/target/linux/qualcommax/dts/ipq5018-rax3000q.dts
@@ -4,6 +4,7 @@
 
 #include "ipq5018.dtsi"
 #include "ipq5018-ess.dtsi"
+#include "ipq5018-nss.dtsi"
 #include "ipq5018-qcn6122.dtsi"
 
 #include <dt-bindings/gpio/gpio.h>
@@ -26,7 +27,11 @@
 	};
 
 	chosen {
-		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
+		/* 256 MB boards use a 512K coherent pool: the old MPD firmware
+		 * loader that took its segment buffers from the atomic pool is
+		 * gone, multi-PD is handled in ath11k now. Keep ubi.mtd=rootfs
+		 * so a U-Boot that does not pass it still boots. */
+		bootargs-append = " root=/dev/ubiblock0_1 ubi.mtd=rootfs coherent_pool=512K";
 		stdout-path = "serial0:115200n8";
 	};
 
@@ -76,6 +81,37 @@
 	};
 };
 
+/*
+ * Q6 memory for the 5 GHz user PD: both radios run on one Q6, the second on
+ * PD 2, and each PD needs its own no-map region behind the shared one -
+ * ipq5018-qcn6122.dtsi carries the 2.4 GHz side.  Addresses are the 256 MB
+ * ipq50xx layout (0x4b000000 q6_region, 0x4c400000 PD1, 0x4d200000 PD2,
+ * 0x4df00000 M3 dump), the same one the other 256 MB boards use.
+ */
+/ {
+	reserved-memory {
+		q6_region_qcn6122_1: q6-region-qcn6122-1@4d200000 {
+			reg = <0x0 0x4d200000 0x0 0xd00000>;
+			no-map;
+		};
+
+		m3_dump_qcn6122_1: m3-dump-qcn6122-1@4df00000 {
+			reg = <0x0 0x4df00000 0x0 0x100000>;
+			no-map;
+		};
+	};
+};
+
+/*
+ * 256 MB board: the stock firmware (AP-MP02.1, MP_256) keeps the NSS
+ * firmware in 8 MiB; ipq5018.dtsi sizes the region for 512 MB boards.
+ * The driver reports whatever it finds as heap_ddr_size and the MP firmware
+ * boots and runs at full throughput in 8 MiB.
+ */
+&nss_region {
+	reg = <0x0 0x40000000 0x0 0x800000>;
+};
+
 &sleep_clk {
 	clock-frequency = <32000>;
 };
@@ -109,13 +145,19 @@
 	pinctrl-names = "default";
 	status = "okay";
 
-	//GigaDevice GD5F1GQ5REYIG
+	/*
+	 * Two parts ship on this board: GigaDevice GD5F1GQ5REYIG and
+	 * Dosilicon DS35Q1GA-IB / DS35M1GA (manufacturer id 0xe5, added by
+	 * target/linux/qualcommax/patches-6.18/0810).  The vendor bootloader
+	 * and the stock firmware use 4-bit ECC per 512 bytes on both; with 8
+	 * the data U-Boot wrote into "rootfs" reads back as ECC errors.
+	 */
 	nand@0 {
 		compatible = "spi-nand";
 		reg = <0>;
 		nand-ecc-engine = <&qpic_nand>;
 		nand-ecc-step-size = <512>;
-		nand-ecc-strength = <8>;
+		nand-ecc-strength = <4>;
 		nand-bus-width = <8>;
 
 		partitions {
@@ -318,10 +360,20 @@
 	};
 };
 
-//256M RAM is too small for ath11k, so WiFi is disabled to prevent OOM.
 
+/*
+ * Both radios are enabled on this port: the image is built for 256 MB
+ * (ATH11K_MEM_PROFILE_256M + NSS_MEM_PROFILE_LOW), which is what makes
+ * ath11k fit here, and mode 2 is the profile the NSS wifili path needs.
+ * Upstream disables them because it ships the 512 MB defaults.
+ *
+ * Upstream's own version of this file uses the multi-PD remoteproc labels
+ * (q6_wcss_pd1 / q6_wcss_pd2), which no longer exist in this kernel: the
+ * IPQ5018 Q6 is a single rproc with the user PD selected through boot-args,
+ * and each radio gets its own fixed memory region.  This is the wiring the
+ * branch validates on the other 256 MB boards (EX511 v2, AX3000T v2).
+ */
 &q6v5_wcss {
-	status = "disabled";
 	/* The QCN6102 radio should map to UPD ID 2. Without       */
 	/* bootargs, the firmware will expect it to be on UPD ID 3 */
 
@@ -335,22 +387,21 @@
 
 &wifi {
 	// IPQ5018
-	status = "disabled";
+	status = "okay";
 
-	qcom,rproc = <&q6_wcss_pd1>;
+	qcom,rproc = <&q6v5_wcss>;
 	qcom,calibration-variant = "CMCC-RAX3000Q";
-	qcom,ath11k-fw-memory-mode = <1>;
-	qcom,bdf-addr = <0x4c400000>;
+	qcom,ath11k-fw-memory-mode = <2>;
 };
 
 &wifi1 {
 	// QCN6102 5G
-	status = "disabled";
+	status = "okay";
 
-	qcom,rproc = <&q6_wcss_pd2>;
-	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
+	qcom,rproc = <&q6v5_wcss>;
 	qcom,calibration-variant = "CMCC-RAX3000Q";
-	qcom,ath11k-fw-memory-mode = <1>;
-	qcom,bdf-addr = <0x4d100000>;
-	qcom,m3-dump-addr = <0x4df00000>;
+	qcom,ath11k-fw-memory-mode = <2>;
+
+	memory-region = <&q6_region_qcn6122_1>, <&q6_region_ipq5018>, <&m3_dump_qcn6122_1>;
+	memory-region-names = "q6-region", "m3-region", "m3-dump";
 };
diff --git a/target/linux/qualcommax/image/ipq50xx.mk b/target/linux/qualcommax/image/ipq50xx.mk
index 067d2a5..791642a 100644
--- a/target/linux/qualcommax/image/ipq50xx.mk
+++ b/target/linux/qualcommax/image/ipq50xx.mk
@@ -119,6 +119,17 @@ define Device/cmcc_rax3000q
 	PAGESIZE := 2048
 	IMAGE_SIZE := 59392k
 	NAND_SIZE := 128m
+	# upstream ships this device without DEVICE_PACKAGES, so a stock
+	# image carries neither ath11k firmware nor the board's BDF.
+	# hostapd-mbedtls is the full feature set (WNM = 802.11v); both wpad
+	# variants are excluded - the board is AP-only and a supplicant would
+	# just idle.  The USB/ext4 lines cancel the subtarget's DEFAULT_PACKAGES:
+	# no USB port here and the rootfs is UBIFS.
+	DEVICE_PACKAGES := ath11k-firmware-ipq5018-qcn6122 \
+		ipq-wifi-cmcc_rax3000q \
+		-wpad-basic-mbedtls -wpad-mbedtls hostapd-mbedtls \
+		-kmod-usb3 -kmod-usb-dwc3 -kmod-usb-dwc3-qcom \
+		-e2fsprogs -kmod-fs-ext4 -losetup
 endef
 TARGET_DEVICES += cmcc_rax3000q
 
diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
index 0861b42..57c65cc 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
@@ -31,6 +31,15 @@ case "$FIRMWARE" in
 		ath11k_set_macflag
 		ath11k_remove_regdomain
 		;;
+	cmcc,rax3000q)
+		# Raw extract only, no MAC or regdomain patching.  This cal blob
+		# begins with the board's own RF tables: ath11k_patch_mac rewrites
+		# bytes 0x0e-0x13 of them, the firmware then asserts in
+		# phyrf_reset.c and never reaches WMI ready (both radios die with
+		# "failed to receive wmi unified ready event: -110").  The vendor
+		# image extracts it as-is.
+		caldata_extract "0:art" 0x1000 0x20000
+		;;
 	cudy,p5)
 		caldata_extract "0:art" 0x1000 0x20000
 		wlan_mac=$(get_mac_binary "$(find_mtd_chardev bdinfo)" 0xde00)
@@ -166,6 +175,11 @@ case "$FIRMWARE" in
 		ath11k_remove_regdomain
 		ath11k_set_macflag
 		;;
+	cmcc,rax3000q)
+		# Same as the 2.4 GHz part: raw extract, no MAC or regdomain
+		# patching (see the comment in the IPQ5018 case above).
+		caldata_extract "0:art" 0x26800 0x20000
+		;;
 	cudy,p5)
 		caldata_extract "0:art" 0x26800 0x20000
 		wlan_mac=$(get_mac_binary "$(find_mtd_chardev bdinfo)" 0xde00)
