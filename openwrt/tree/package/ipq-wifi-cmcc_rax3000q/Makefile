#
# Board data (BDF) for the CMCC RAX3000Q / RAX3000-QY
# (IPQ5018 integrated 2.4 GHz + QCN6102 5 GHz, exposed to ath11k as QCN6122).
#
# Upstream OpenWrt defines Device/cmcc_rax3000q with no DEVICE_PACKAGES, so a
# stock image carries neither the ath11k firmware nor this board's calibration
# and the radios never probe.  Our image Makefile fixes that too; this package
# supplies the board data.
#
# files/board-2.bin.{IPQ5018,QCN6122} are generated by scripts/mkboard2.py from
# src/board-cmcc_rax3000q.*, the community-published BDF for this exact board
# (hzyitc/openwrt-redmi-ax3000, package/firmware/ipq-wifi/src).  The generator
# publishes the same payload under several board names, because QSDK names BDFs
# by qmi-board-id 36/96 while mainline ath11k usually reports 255 and appends
# the DT calibration variant "CMCC-RAX3000Q".  See scripts/mkboard2.py.
#
# Installing board-2.bin here intentionally overwrites the generic one shipped
# by ath11k-firmware-ipq5018-qcn6122 - that is exactly how OpenWrt's own
# ipq-wifi-* packages work.

include $(TOPDIR)/rules.mk

PKG_NAME:=ipq-wifi-cmcc_rax3000q
PKG_RELEASE:=1
PKG_FLAGS:=nonshared

include $(INCLUDE_DIR)/package.mk

define Package/ipq-wifi-cmcc_rax3000q
  SECTION:=firmware
  CATEGORY:=Firmware
  TITLE:=Board data for CMCC RAX3000Q (IPQ5018 + QCN6102)
  DEPENDS:=@TARGET_qualcommax_ipq50xx
endef

define Package/ipq-wifi-cmcc_rax3000q/description
  Device specific ath11k board data for the CMCC RAX3000Q / RAX3000-QY.
endef

define Build/Compile
endef

define Package/ipq-wifi-cmcc_rax3000q/install
	$(INSTALL_DIR) $(1)/lib/firmware/ath11k/IPQ5018/hw1.0
	$(INSTALL_DATA) ./files/board-2.bin.IPQ5018 $(1)/lib/firmware/ath11k/IPQ5018/hw1.0/board-2.bin
	$(INSTALL_DIR) $(1)/lib/firmware/ath11k/QCN6122/hw1.0
	$(INSTALL_DATA) ./files/board-2.bin.QCN6122 $(1)/lib/firmware/ath11k/QCN6122/hw1.0/board-2.bin
endef

$(eval $(call BuildPackage,ipq-wifi-cmcc_rax3000q))
