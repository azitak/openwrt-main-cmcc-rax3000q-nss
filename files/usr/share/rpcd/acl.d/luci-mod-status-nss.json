{
	"luci-mod-status-nss": {
		"description": "Grant read access to NSS, thermal, zram and CPU status widgets",
		"read": {
			"file": {
				"/sys/kernel/debug/qca-nss-drv/stats/ipv4": [ "read" ],
				"/sys/kernel/debug/qca-nss-drv/stats/ipv6": [ "read" ],
				"/sys/kernel/debug/qca-nss-drv/stats/cpu_load_ubi": [ "read" ],
				"/sys/kernel/debug/qca-dwmac-nss/status": [ "read" ],
				"/sys/kernel/debug/ecm/ecm_db/connection_count": [ "read" ],
				"/sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone0/type": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone0/temp": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone1/type": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone1/temp": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone2/type": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone2/temp": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone3/type": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone3/temp": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone0/hwmon0/name": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone0/hwmon0/temp1_input": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone1/hwmon1/name": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone1/hwmon1/temp1_input": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone2/hwmon2/name": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone2/hwmon2/temp1_input": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone3/hwmon3/name": [ "read" ],
				"/sys/devices/virtual/thermal/thermal_zone3/hwmon3/temp1_input": [ "read" ],
				"/sys/devices/platform/soc@0/c000000.wifi/ieee80211/phy0/hwmon4/name": [ "read" ],
				"/sys/devices/platform/soc@0/c000000.wifi/ieee80211/phy0/hwmon4/temp1_input": [ "read" ],
				"/sys/devices/platform/soc@0/b00a040.wifi/ieee80211/phy1/hwmon5/name": [ "read" ],
				"/sys/devices/platform/soc@0/b00a040.wifi/ieee80211/phy1/hwmon5/temp1_input": [ "read" ],
				"/sys/devices/virtual/block/zram0/disksize": [ "read" ],
				"/sys/devices/virtual/block/zram0/mm_stat": [ "read" ],
				"/proc/stat": [ "read" ],
				"/proc/swaps": [ "read" ]
			},
			"ubus": {
				"file": [ "read" ]
			}
		}
	}
}
